                <enumeratedValues>
                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>Loosely packed variant disabled</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>Loosely packed variant enabled</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
