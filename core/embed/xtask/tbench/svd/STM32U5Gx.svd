                    <description>Color bars (horizontal or vertical).</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>BER pattern (vertical only).</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PGO</name>
                <description>Pattern generator orientation
This bit configures the color bar orientation.</description>
                <bitOffset>24</bitOffset>
                <bitWidth>1</bitWidth>
