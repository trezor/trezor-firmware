              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Access to HDP2 area granted</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Access to HDP2 area denied (SECWM2Ry option bytes modification bocked -refer to )</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
