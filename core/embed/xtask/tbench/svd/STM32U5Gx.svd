            <resetValue>0x00000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>URCL</name>
                <description>ULPS request on clock lane
ULPS mode request on clock lane.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
