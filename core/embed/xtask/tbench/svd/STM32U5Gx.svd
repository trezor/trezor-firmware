        <register>
          <name>GPDMA_C15SR</name>
          <displayName>GPDMA_C15SR</displayName>
          <description>channel x status register</description>
          <addressOffset>0x7E0</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <name>IDLEF</name>
