          <description>GPDMA channel x flag clear register</description>
          <addressOffset>0x7DC</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TCF</name>
