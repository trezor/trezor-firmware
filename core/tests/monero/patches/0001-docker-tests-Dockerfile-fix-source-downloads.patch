From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Petr Susil <petr.susil@satoshilabs.com>
Date: Mon, 12 Oct 2026 12:18:07 +0200
Subject: [PATCH] docker/tests/Dockerfile: fix source downloads

- curl: fail on HTTP errors, follow redirects (openssl.org now
  redirects release tarballs) and retry transient errors (e.g. HTTP 500
  from cmake.org), set once in ~/.curlrc
- fetch Boost from archives.boost.io
- libsodium tag renamed to 1.0.17-RELEASE (same commit)
- verify the ncurses tarball
---
 docker/tests/Dockerfile | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/docker/tests/Dockerfile b/docker/tests/Dockerfile
index f923c853c..1cbc74ab1 100644
--- a/docker/tests/Dockerfile
+++ b/docker/tests/Dockerfile
@@ -35,6 +35,9 @@ RUN set -ex && \
         libgtest-dev \
         zlib1g-dev
 
+# Fail on HTTP errors, follow redirects and retry transient errors in every download below.
+RUN printf 'fail\nshow-error\nlocation\nretry = 5\nretry-delay = 10\n' > /root/.curlrc
+
 ARG NBPROC
 WORKDIR /usr/local
 
@@ -72,7 +75,7 @@ ARG BOOST_VERSION=1_69_0
 ARG BOOST_VERSION_DOT=1.69.0
 ARG BOOST_HASH=8f32d4617390d1c2d16f26a27ab60d97807b35440d45891fa340fc2648b04406
 RUN set -ex \
-    && curl -s -L -o  boost_${BOOST_VERSION}.tar.bz2 https://boostorg.jfrog.io/artifactory/main/release/${BOOST_VERSION_DOT}/source/boost_${BOOST_VERSION}.tar.bz2 \
+    && curl -s -L -o  boost_${BOOST_VERSION}.tar.bz2 https://archives.boost.io/release/${BOOST_VERSION_DOT}/source/boost_${BOOST_VERSION}.tar.bz2 \
     && echo "${BOOST_HASH}  boost_${BOOST_VERSION}.tar.bz2" | sha256sum -c \
     && tar -xvf boost_${BOOST_VERSION}.tar.bz2 \
     && cd boost_${BOOST_VERSION} \
@@ -81,7 +84,7 @@ RUN set -ex \
 ENV BOOST_ROOT /usr/local/boost_${BOOST_VERSION}
 
 # Sodium
-ARG SODIUM_VERSION=1.0.17
+ARG SODIUM_VERSION=1.0.17-RELEASE
 ARG SODIUM_HASH=b732443c442239c2e0184820e9b23cca0de0828c
 RUN set -ex \
     && git clone https://github.com/jedisct1/libsodium.git -b ${SODIUM_VERSION} \
@@ -118,8 +121,10 @@ RUN set -ex \
 
 # Ncurses
 ARG NCURSES_VERSION=6.1
+ARG NCURSES_HASH=aa057eeeb4a14d470101eff4597d5833dcef5965331be3528c08d99cebaa0d17
 RUN set -ex \
     && curl -s -O https://ftp.gnu.org/pub/gnu/ncurses/ncurses-${NCURSES_VERSION}.tar.gz \
+    && echo "${NCURSES_HASH}  ncurses-${NCURSES_VERSION}.tar.gz" | sha256sum -c \
     && tar -xzvf ncurses-${NCURSES_VERSION}.tar.gz \
     && cd ncurses-6.1 \
     && ./configure --enable-pc-files --with-shared --with-normal \
