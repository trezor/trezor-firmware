source "Kconfig.zephyr"

menu "Trezor BLE gateway configuration"

config DEFAULT_THREAD_STACK_SIZE
	int "Thread stack size"
	default 1024
	help
	  Common stack size used

config MODEL_IDENTIFIER
    int "Model identifier"

config TRZ_CONSOLE
	bool "BLE console service"
	depends on BT_PERIPHERAL
	select BT_GATT_DYNAMIC_DB
	help
	  Expose a second GATT service that carries an opaque byte console
	  between the STM32 and a bonded host: the prodtest CLI on
	  production-test firmware, debug logs on debug firmware. The bytes are
	  forwarded on their own inter-MCU service id (NRF_SERVICE_CONSOLE) and
	  are not interpreted by the nRF. The service is registered only while
	  the STM32 asks for it (the console flag of the advertising-on command,
	  set by prodtest and debug builds), so production STM32 firmware never
	  exposes it even from an image that carries this option. Leave it off
	  for models whose console stays on USB.

config TRZ_DEBUG_LINK
	bool "BLE debuglink service"
	depends on BT_PERIPHERAL
	select BT_GATT_DYNAMIC_DB
	help
	  Expose a GATT service that carries the debuglink between debug STM32
	  firmware and a bonded host, the counterpart of the USB debug
	  interface on models without USB. Forwarded on its own inter-MCU
	  service id (NRF_SERVICE_DEBUG). Registered only while the STM32 asks
	  for it (the debuglink flag of the advertising-on command, set by
	  --debug-link builds), so a shipping image can carry it; the STM32
	  firmware that enables it is the debug one, which answers debuglink
	  requests from any bonded host.

endmenu
